# weekly-docker-restart.sh — required environment
#
# Copy this file to scripts/.env, fill in real values, and keep it gitignored.
# AIfred/.gitignore already matches **/.env to prevent accidental commits.
#
# These are consumed by scripts/weekly-docker-restart.sh. The n8n webhook
# receives a POST on completion with restart status for email notification.
#
# Generate a fresh webhook path and secret in n8n:
#   1. Open https://n8n.theklyx.space/workflow/<AIServer-Email-workflow-id>
#   2. Webhook node → Path field → regenerate or paste `uuidgen` output
#   3. Credentials → "Header Auth AIServer-Emails" → Value field → paste `openssl rand -hex 24`
#
# Never commit this file with real values.

WEBHOOK_URL="https://n8n.theklyx.space/webhook/REPLACE-WITH-FRESH-UUID"
WEBHOOK_SECRET="REPLACE-WITH-OPENSSL-RAND-HEX-24"
NOTIFICATION_EMAIL="your-email@example.com"
